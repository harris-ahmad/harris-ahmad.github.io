---
// A static stand-in for a moved URL: meta refresh plus a canonical link to the new location.
interface Props {
  to: string;
}
const { to } = Astro.props;
const target = new URL(to, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>This page has moved to <a href={to}>{target}</a>.</p>
  </body>
</html>
