---
// Full work history, ported from _pages/work-experience.md.
// The transaction reordering bullet uses the approved public wording only (unpublished research).
import Page from '../layouts/Page.astro';
import { site } from '../data/site';
---
<Page
  title="Work Experience — Harris Ahmad"
  description="Software engineering and research experience — University at Buffalo, Linq.io, Its IT Group, LUMS, and distributed systems work."
  path="/work-experience"
  keywords="work experience, software engineer, research engineer, University at Buffalo, distributed systems, transactions, FastAPI, Go, YC, Y Combinator"
  heading="Work Experience"
  lede="Software engineering and research experience at the University at Buffalo, Linq.io, Its IT Group and LUMS."
>
  <div slot="meta" class="links">
    <a href={site.resume}>Résumé (PDF)</a>
    <a href={`mailto:${site.email}`}>Email</a>
  </div>

  <div class="stack">
    <!-- Professional -->
    <section class="block" aria-labelledby="professional">
      <div class="sec-head">
        <h2 id="professional" class="eyebrow">Professional experience</h2>
      </div>

      <ol class="roles">
        <li class="hang">
          <div class="m"><span>Jan 2025 – present</span><span class="where">Buffalo, NY</span></div>
          <div class="role">
            <h3>Research Software Engineer <span class="org">· University at Buffalo (SUNY)</span></h3>
            <ul class="bullets">
              <li>Building a transaction reordering layer in Go that lowers tail latency and aborts of existing strictly serializable concurrency control without changing its code: up to 75% lower tail latency and 85% fewer aborts across 2PL, OCC and NCC on CloudLab; in preparation for USENIX OSDI 2027.</li>
              <li>Prototyped primary-backup, chain replication, and distributed two-phase locking in Go to stress-test protocol behavior for collaborative AI workloads on CloudLab (NSF-supported).</li>
              <li>Building a coordination-free concurrency protocol for microservices in Java that keeps distributed transactions correct without the central coordinator and global row locks Apache Seata holds across a commit, which serialize conflicting transactions and add a round trip to every one; in preparation for USENIX OSDI 2027.</li>
            </ul>
          </div>
        </li>

        <li class="hang">
          <div class="m"><span>Jul – Dec 2024</span><span class="where">Dallas, TX</span></div>
          <div class="role">
            <h3>Software Engineer <span class="org">· Linq.io (remote)</span></h3>
            <ul class="bullets">
              <li>Engineered a playground and diagnostics platform for an asset-management system: workflow simulation, feature validation, and API testing, with observability through structured logging, distributed tracing, fault isolation, and real-time monitoring.</li>
              <li>Shipped an on-demand media-generation API (FastAPI, MongoDB) that cut page load by 60% by generating asset thumbnails as users browsed 10K+ inventories.</li>
              <li>Integrated OAuth 2.0 SSO for enterprise accounts so customers could sign in with existing corporate credentials.</li>
              <li>On call twice a week for production pipelines and client issues, tracked in Jira; weekly PR reviews with senior engineers.</li>
            </ul>
          </div>
        </li>

        <li class="hang">
          <div class="m"><span>May – Dec 2024</span><span class="where">Lahore, PK</span></div>
          <div class="role">
            <h3>System Engineer <span class="org">· Its IT Group (contract, remote)</span></h3>
            <ul class="bullets">
              <li>Redesigned the Node.js / MongoDB backend of an AR app for VTuber/karaoke 3D avatars with WebSockets for real-time comments, notifications, and likes across 5K+ daily active users.</li>
              <li>Implemented a 3D model pipeline for LiDAR scans with a USDZ → GLB converter for Unity integration, cutting manual measurement time by 80%.</li>
            </ul>
          </div>
        </li>

        <li class="hang">
          <div class="m"><span>Oct 2023 – Mar 2024</span><span class="where">Lahore, PK</span></div>
          <div class="role">
            <h3>Software Engineer <span class="org">· Interactive Media Lab, LUMS</span></h3>
            <ul class="bullets">
              <li>Built Awaaz-e-Sehat, a HIPAA-aligned e-health platform on Flask and AWS Lambda, improving API latency from 5s → 500ms for 20K+ daily active users.</li>
              <li>Productionized Whisper + GPT-4 transcription into structured clinical notes (95% accuracy, 1K+ recordings/day).</li>
              <li>Ran a serverless ingest and search stack (Lambda, DynamoDB, S3) with automatic scaling; Redis caching reduced API latency by ~30%.</li>
            </ul>
          </div>
        </li>
      </ol>
    </section>

    <!-- Research -->
    <section class="block" aria-labelledby="research-experience">
      <div class="sec-head">
        <h2 id="research-experience" class="eyebrow">Research experience</h2>
      </div>

      <ol class="roles">
        <li class="hang">
          <div class="m"><span>May 2022 – Dec 2023</span><span class="where">Lahore, PK</span></div>
          <div class="role">
            <h3>Research Software Engineer <span class="org">· Network and Systems Group, LUMS</span></h3>
            <ul class="bullets">
              <li>Released a public dataset covering 17.6K videos and 46.6K ads across 8 countries with per-video buffer telemetry, the first large-scale YouTube corpus with that coverage.</li>
              <li>Measured how YouTube main-video bitrate drives buffer loss across resolutions (720p ~3× higher latent buffer loss than 360p; 10.1 MB vs 3.4 MB).</li>
              <li>Built the distributed collection and analysis toolchain (Selenium/PyTube) behind the corpus and released it publicly alongside the dataset.</li>
              <li>Published at The ACM Web Conference 2024 (WWW ’24): <a href="https://doi.org/10.1145/3589334.3645496">doi:10.1145/3589334.3645496</a>.</li>
            </ul>
          </div>
        </li>
      </ol>
    </section>

    <!-- Teaching -->
    <section class="block" aria-labelledby="teaching">
      <div class="sec-head">
        <h2 id="teaching" class="eyebrow">Teaching experience</h2>
      </div>

      <ol class="roles">
        <li class="hang">
          <div class="m"><span>Spring 2025</span><span class="where">Buffalo, NY</span></div>
          <div class="role">
            <h3>Teaching Assistant <span class="org">· University at Buffalo</span></h3>
            <ul class="bullets">
              <li>Modern Networking Concepts (CSE 489/589)</li>
            </ul>
          </div>
        </li>

        <li class="hang">
          <div class="m"><span><span class="nw">Spring 2023,</span> <span class="nw">Fall 2023</span></span><span class="where">Lahore, PK</span></div>
          <div class="role">
            <h3>Teaching Assistant <span class="org">· Lahore University of Management Sciences</span></h3>
            <ul class="bullets">
              <li>CS200: Object Oriented Design in C++ (Spring ’23, Fall ’23)</li>
              <li>CS582: Distributed Systems (Fall ’23)</li>
            </ul>
          </div>
        </li>
      </ol>
    </section>

    <!-- Education and programs -->
    <section class="block" aria-labelledby="education">
      <div class="sec-head">
        <h2 id="education" class="eyebrow">Education &amp; programs</h2>
      </div>

      <ol class="roles">
        <li class="hang">
          <div class="m"><span><span class="nw">Jan 2025 – May 2028</span> (expected)</span><span class="where">Buffalo, NY</span></div>
          <div class="role">
            <h3>PhD, Computer Science <span class="org">· University at Buffalo (SUNY)</span></h3>
            <ul class="bullets">
              <li>Available for Summer 2027 software engineering / research internships, returning to the PhD afterwards.</li>
            </ul>
          </div>
        </li>

        <li class="hang">
          <div class="m"><span>Sep 2020 – May 2024</span><span class="where">Lahore, PK</span></div>
          <div class="role">
            <h3>BS, Computer Science <span class="org">· Lahore University of Management Sciences (LUMS)</span></h3>
          </div>
        </li>

        <li class="hang">
          <div class="m"><span>Jul 2026</span><span class="where">San Francisco Bay Area</span></div>
          <div class="role">
            <h3>Participant <span class="org">· Y Combinator AI Startup School</span></h3>
            <ul class="bullets">
              <li>Selected from a pool of 30,000 applications for YC’s AI Startup School 2026 at Chase Center, a program for builders working on AI products and research.</li>
              <li>Joined office hours and 1:1 conversations with founders and operators about what we’re building; networked with peers across AI systems, products, and research.</li>
            </ul>
            <figure class="gallery">
              <div class="shots">
                <a href="/images/yc-ai-startup-school-2026/yc-badge.jpg" title="YC AI Startup School 2026">
                  <img src="/images/yc-ai-startup-school-2026/yc-badge-thumb.jpg" alt="Harris Ahmad at Y Combinator AI Startup School 2026" width="520" height="693" loading="lazy" decoding="async" />
                </a>
                <a href="/images/yc-ai-startup-school-2026/chase-center.jpg" title="Chase Center — YC AI Startup School">
                  <img src="/images/yc-ai-startup-school-2026/chase-center-thumb.jpg" alt="Crowd outside Chase Center during YC AI Startup School office hours" width="520" height="693" loading="lazy" decoding="async" />
                </a>
              </div>
              <figcaption>YC AI Startup School 2026 — San Francisco (Chase Center)</figcaption>
            </figure>
          </div>
        </li>
      </ol>
    </section>

    <!-- Earlier -->
    <section class="block" aria-labelledby="earlier">
      <div class="sec-head">
        <h2 id="earlier" class="eyebrow">Earlier experience</h2>
      </div>

      <ol class="roles">
        <li class="hang">
          <div class="m"><span>2022 – 2023</span></div>
          <div class="role">
            <h3>Backend / frontend coursework projects &amp; short roles <span class="org">· LUMS</span></h3>
            <p class="desc">P2P file sharing with DHTs, speech-therapy MERN app (Guftaar), and a short course-website engagement for an Internet Architecture workshop.</p>
          </div>
        </li>

        <li class="hang">
          <div class="m"><span>2021</span></div>
          <div class="role">
            <h3>Machine Learning Developer (freelance) <span class="org">· Fiverr</span></h3>
            <p class="desc">Dataset cleaning, model comparison, and end-to-end ML pipelines for client projects.</p>
          </div>
        </li>
      </ol>
    </section>
  </div>
</Page>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  /* Locations sit under the dates in the margin; balance keeps two-line places even */
  .where {
    text-wrap: balance;
  }

  /* Keeps a term or date range on one line in the 9.5rem margin
     ("Spring 2023, / Fall 2023", not "Spring 2023, Fall / 2023") */
  .nw {
    white-space: nowrap;
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    min-width: 0;
  }

  .role h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .org {
    font-weight: 400;
    color: var(--muted);
  }

  /* Bullets: same rhythm and markers as .prose lists */
  .bullets {
    display: flex;
    flex-direction: column;
    gap: .375rem;
    padding-left: 1.25rem;
    list-style: disc;
    font-size: .9375rem;
    line-height: 1.6;
  }

  .bullets li {
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  .bullets li::marker {
    color: var(--faint);
  }

  .desc {
    font-size: .9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* YC photos: two columns, one on phones */
  .gallery {
    display: flex;
    flex-direction: column;
    gap: .625rem;
    max-width: 36rem;
    margin-top: .75rem;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
  }

  .shots a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--tint);
  }

  .shots a:hover {
    border-color: var(--rule-strong);
  }

  .shots img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery figcaption {
    font-size: .875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 540px) {
    .shots {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
